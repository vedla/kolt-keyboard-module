{
  "name": "@kolt/kolt-keyboard-module",
  "version": "0.1.0",
  "description": "Kolt Custom Keyboard",
  "keywords": [
    "react-native",
    "expo",
    "kolt-keyboard",
    "KoltKeyboard"
  ],
  "homepage": "https://gitlab.com/vedla/kolt-keyboard-module#readme",
  "bugs": {
    "url": "https://gitlab.com/vedla/kolt-keyboard-module/issues"
  },
  "repository": "https://gitlab.com/vedla/kolt-keyboard-module",
  "license": "MIT",
  "author": "Vedla <code@vedla.ca> (https://gitlab.com/vedla)",
  "exports": {
    ".": "./src/index.ts",
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "open:android": "node internal/module_scripts/open-android.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "test": "node internal/module_scripts/test.js"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "dependencies": {
    "@expo/config-plugins": "~57.0.9"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "packageManager": "yarn@4.18.0"
}
